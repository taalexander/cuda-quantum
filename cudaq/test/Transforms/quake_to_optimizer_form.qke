// RUN: cudaq-opt --verify-each --quake-to-optimizer-form %s -split-input-file -verify-diagnostics | FileCheck %s --check-prefixes=FORM,PAIR
// RUN: cudaq-opt --verify-each --pass-pipeline='builtin.module(quake-to-optimizer-form)' %s -split-input-file -verify-diagnostics | FileCheck %s --check-prefixes=FORM,PAIR
// RUN: cudaq-opt --verify-each --pass-pipeline='builtin.module(quake-to-optimizer-form,func.func(quake-simplify))' %s -split-input-file -verify-diagnostics | FileCheck %s --check-prefixes=FORM,SIMPLIFIED

func.func private @callee(!quake.veq<?>)

func.func @optimizer_form(%dynamic : !quake.veq<?>) {
  %controls = quake.alloca !quake.veq<2>
  %target = quake.alloca !quake.ref
  quake.h %target : (!quake.ref) -> ()
  quake.h %target : (!quake.ref) -> ()
  quake.x [%controls neg [true]] %target : (!quake.veq<2>, !quake.ref) -> ()
  %relaxed = quake.relax_size %controls : (!quake.veq<2>) -> !quake.veq<?>
  call @callee(%relaxed) : (!quake.veq<?>) -> ()
  quake.dealloc %target : !quake.ref
  quake.dealloc %controls : !quake.veq<2>
  return
}

// FORM-LABEL: func.func @optimizer_form(
// FORM-SAME:      %{{.*}}: !quake.veq<?>
// FORM:         %[[CONTROL0:.*]] = quake.null_wire
// FORM:         %[[CONTROL1:.*]] = quake.null_wire
// FORM:         %[[TARGET:.*]] = quake.null_wire
// PAIR-COUNT-2: quake.h
// SIMPLIFIED-NOT: quake.h
// FORM:         %[[CONTROLLED:.*]]:3 = quake.x [%{{.*}}, %{{.*}} neg [true, true]] %{{.*}} : (!quake.wire, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire, !quake.wire)
// FORM:         %[[CABLE:.*]] = quake.bundle_cable %{{.*}}, %{{.*}} : (!quake.wire, !quake.wire) -> !quake.cable<2>
// FORM:         %[[CALL:.*]] = quake.call_by_ref @callee(%[[CABLE]]) : (!quake.cable<2>) -> !quake.cable<2>
// FORM:         %[[SPLIT:.*]]:2 = quake.split_cable %[[CALL]] : (!quake.cable<2>) -> (!quake.wire, !quake.wire)
// FORM:         quake.sink %[[SPLIT]]#0 : !quake.wire
// FORM:         quake.sink %[[SPLIT]]#1 : !quake.wire
// FORM-NOT:     quake.extract_ref
// FORM:         return

// -----

func.func @branch_control(%condition : i1) {
  %control = quake.null_wire
  %target = quake.null_wire
  // expected-error@+1 {{cannot linearize a reusable control across incomparable control-flow paths}}
  %reusable = quake.to_ctrl %control : (!quake.wire) -> !quake.control
  cf.cond_br %condition, ^left(%target : !quake.wire), ^right(%target : !quake.wire)

^left(%left : !quake.wire):
  %left_out = quake.x [%reusable] %left : (!quake.control, !quake.wire) -> !quake.wire
  cf.br ^done(%left_out : !quake.wire)

^right(%right : !quake.wire):
  %right_out = quake.z [%reusable] %right : (!quake.control, !quake.wire) -> !quake.wire
  cf.br ^done(%right_out : !quake.wire)

^done(%target_out : !quake.wire):
  %restored = quake.from_ctrl %reusable : (!quake.control) -> !quake.wire
  quake.sink %restored : !quake.wire
  quake.sink %target_out : !quake.wire
  return
}
